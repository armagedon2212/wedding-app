{
  "entities": {
    "Photo": {
      "title": "Photo",
      "description": "Represents an uploaded photo.",
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "createdAt": { "type": "object", "description": "Server Timestamp" },
        "status": { "type": "string", "enum": ["active", "deleted"] },
        "uploaderId": { "type": "string" }
      },
      "required": ["url", "thumbnailUrl", "createdAt", "status", "uploaderId"]
    },
    "Song": {
      "title": "Song",
      "description": "Represents a song suggestion.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "createdAt": { "type": "object", "description": "Server Timestamp" },
        "status": { "type": "string", "enum": ["active", "deleted"] },
        "suggesterId": { "type": "string" },
        "voteCount": { "type": "number" }
      },
      "required": ["title", "artist", "createdAt", "status", "suggesterId", "voteCount"]
    },
    "Vote": {
      "title": "Vote",
      "description": "Represents a vote on a song.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "value": { "type": "number", "enum": [1, -1] }
      },
      "required": ["userId", "value"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Dynamic configuration representing photo lock, menu sections, schedule events, bingo prompts, general configuration, and admin emails.",
      "type": "object",
      "properties": {
        "unlockTime": { "type": "number", "description": "Epoch timestamp of photo release." },
        "sections": {
          "type": "array",
          "description": "Menu categories with dishes."
        },
        "events": {
          "type": "array",
          "description": "Wedding events schedule list."
        },
        "prompts": {
          "type": "array",
          "description": "9 bingo prompt strings."
        },
        "title": {
          "type": "string",
          "description": "The title of the wedding browser application."
        },
        "faviconUrl": {
          "type": "string",
          "description": "The URL of the pages favicon."
        },
        "emails": {
          "type": "array",
          "description": "List of emails of other administrators."
        }
      }
    }
  },
  "firestore": {
    "photos": {
      "schema": "Photo",
      "description": "Global collection of all photos uploaded during the wedding."
    },
    "songs": {
      "schema": "Song",
      "description": "Global collection of suggested songs."
    },
    "songs/{songId}/votes": {
      "schema": "Vote",
      "description": "Votes for a song to ensure users can only vote once."
    },
    "settings/{settingId}": {
      "schema": "Setting",
      "description": "Dynamic configurable variables like unlock duration, menu, schedule, and bingo."
    }
  }
}
